{
  "platform": { "apiRuntime": "node:20" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "*.{css,js,png,jpg,svg,ico,webp,woff2}"]
  },
  "routes": [{ "route": "/api/*", "allowedRoles": ["anonymous"] }],
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "no-referrer" }
}
